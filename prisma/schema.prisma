generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

model Pet {
  id          String @id @default(uuid())
  ownerId     String
  name        String
  description String
  age         Int
  breed       String
  color       String
  size        String
  owner       Org    @relation(fields: [ownerId], references: [id])

  @@map("pets")
}

model Org {
  id           String @id @default(uuid())
  name         String
  owner_name   String
  email        String @unique
  password     String
  phone        String
  city         String
  state        String
  neighborhood String
  address      String
  cep          String
  pets         Pet[]

  @@map("orgs")
}
