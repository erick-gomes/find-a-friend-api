  "devDependencies": {
    "@rocketseat/eslint-config": "2.2.2",
    "@types/node": "22.14.1",
    "npm-run-all": "4.1.5",
    "prisma": "6.6.0",
    "tsup": "8.4.0",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "vitest": "3.1.1"
  },
  "dependencies": {
    "@prisma/client": "6.6.0",
